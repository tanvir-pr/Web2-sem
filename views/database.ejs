<%- include("partials/header") %>

<section class="panel">
    <h1>Database</h1>
    <p class="lede">Three collections from the Waste Transport dataset, loaded with Mongoose ODM.</p>

    <h2>Services <span class="badge"><%= services.length %></span></h2>
    <div class="table-wrap">
        <table>
            <thead>
                <tr><th>ID</th><th>Type</th><th>Description</th></tr>
            </thead>
            <tbody>
                <% services.forEach(function(s) { %>
                    <tr>
                        <td><%= s.id %></td>
                        <td><%= s.wtype %></td>
                        <td><%= s.description %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

    <h2>Calendar <span class="badge">showing <%= calendar.length %> / <%= calendarTotal %></span></h2>
    <div class="table-wrap">
        <table>
            <thead>
                <tr><th>ID</th><th>Date</th><th>Service</th></tr>
            </thead>
            <tbody>
                <% calendar.forEach(function(c) { %>
                    <tr>
                        <td><%= c.id %></td>
                        <td><%= c.sdateLabel %></td>
                        <td><%= c.serviceLabel %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

    <h2>Resident demands <span class="badge">showing <%= resdems.length %> / <%= resdemTotal %></span></h2>
    <div class="table-wrap">
        <table>
            <thead>
                <tr><th>ID</th><th>Demand date</th><th>Type</th><th>Quantity</th></tr>
            </thead>
            <tbody>
                <% resdems.forEach(function(r) { %>
                    <tr>
                        <td><%= r.id %></td>
                        <td><%= r.demandLabel %></td>
                        <td><%= r.serviceLabel %></td>
                        <td><%= r.quantity %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</section>

<%- include("partials/footer") %>
