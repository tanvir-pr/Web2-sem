<%- include("partials/header") %>

<section class="hero">
    <div class="hero-copy">
        <p class="eyebrow">Public waste service · 2018 dataset</p>
        <h1>Clean streets start with a clear calendar.</h1>
        <p class="lede">
            EcoHaul helps residents follow yearly waste transport schedules,
            track personal collection demands, and understand every waste type —
            plastic, glass, green, paper, and communal.
        </p>
        <div class="hero-actions">
            <a class="btn btn-primary" href="/database">Browse database</a>
            <a class="btn btn-ghost" href="/contact">Contact the service</a>
        </div>
    </div>
    <div class="hero-panel" aria-hidden="true">
        <div class="hero-card">
            <strong>5</strong>
            <span>waste types</span>
        </div>
        <div class="hero-card">
            <strong>Year</strong>
            <span>full 2018 calendar</span>
        </div>
        <div class="hero-card">
            <strong>ODM</strong>
            <span>Mongoose models</span>
        </div>
    </div>
</section>

<section class="features">
    <article>
        <h2>Transport calendar</h2>
        <p>See which waste type is collected on which day — one trip per day, multiple types possible.</p>
    </article>
    <article>
        <h2>Resident demands</h2>
        <p>Explore how many bags, boxes, or containers a household put out across the year.</p>
    </article>
    <article>
        <h2>Charts &amp; admin tools</h2>
        <p>Visual summaries with Chart.js. Administrators can maintain the services catalogue via CRUD.</p>
    </article>
</section>

<%- include("partials/footer") %>
